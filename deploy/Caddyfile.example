# 当前阶段（备案审核中，不用域名）：只用 IP + HTTP 访问，例如 http://服务器IP/
# Caddy 对 ":80" 这种写法不会申请证书，也不会跳转 HTTPS。
:80 {
	root * /var/www/talekiln
	file_server
	encode gzip
	header /assets/* Cache-Control "public, max-age=86400"
}

# 备案通过、域名已解析到本机后：删掉上面一段，换成下面这段（去掉 # 并改成你的域名），
# Caddy 会自动申请 HTTPS 证书，并把 http 跳转到 https。
# 你的域名.com, www.你的域名.com {
# 	root * /var/www/talekiln
# 	file_server
# 	encode gzip
# 	header /assets/* Cache-Control "public, max-age=86400"
# }
